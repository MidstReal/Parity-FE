; output file format
`format ELF64 executable 3`

@entry(_start)              ; program entry point (label _start)

; start of data section
<Data>

    byte i = 0              ; variable i
    byte a = 5             ; variable a

    char msg = "hello",10   ; variable msg

; start of code section
<Code>

    label _start            ; program entry point
        while(i, <, a)      ; start of while condition (start of loop)
            print(&msg, 6)  ; call function
            @inc([i])       ; assembler operation "inc" (i += 1), in asm "inc [i]"
        end.                ; end of while condition
        
        syscall(60)         ; exit

    func print              ; start of function print
        rsi = $arg_0
        rdx = $arg_1
        rdi = 1
        syscall(1)
    end.                    ; end of function print

; output:
; hello
; hello
; hello
; hello
; hello