; output file format
`format ELF64 executable 3`

@entry(_start)              ; program entry point (label _start)

; start of variables section
`segment readable writeable`

    byte i = 1              ; variable i
    byte a = 1              ; variable a

    char msg = "hello",10   ; variable msg

; start of code section
`segment readable executable`

    label _start            ; program entry point
        if(i, ==, a)        ; start of if condition
            print(msg, 6)  ; call function
        end.                ; end of if condition
        
        syscall(60)         ; exit

    func print              ; start of function print
        rsi = $arg_0
        rdx = $arg_1
        rdi = 1
        syscall(1)
    end.                    ; end of function print

; output:
; hello
